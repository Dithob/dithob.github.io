---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { brand, capabilities, focusItems, projects, signals, workflowSteps } from '../../data';
const featuredProjects = projects.filter((project) => project.featured);
---
<BaseLayout title="wujue / Dithob — AI tools and engineering" description="Building runnable, explainable, and verifiable AI tools." lang="en" path="/en/">
  <section class="hero shell"><div class="hero-content"><div class="hero-kicker"><span>01</span> PERSONAL SYSTEM / 2026</div><h1>{brand.taglineEn}</h1><p class="lead">{brand.positioningEn}</p><div class="actions"><a class="button primary" href="/en/projects/">View projects →</a><a class="button" href="/en/resume/">Resume</a><a class="button" href="/en/notes/">Notes</a></div></div><aside class="hero-aside"><div class="hero-stamp" aria-hidden="true">D/</div><div class="hero-aside-block"><span class="mini-label">NOW BUILDING</span><p>PaperQAAgent · DeepResume · reusable agent skills</p></div><div class="hero-aside-block"><span class="mini-label">HOW I WORK</span><p>Separate verified facts, inference, and external state; ship validation and boundaries with the artifact.</p></div><div class="hero-aside-code">OPEN SOURCE<br />LOCAL FIRST<br />EVIDENCE LED</div></aside><div class="hero-corner" aria-hidden="true">AI / AGENT / QA</div></section>
  <section class="signal-strip shell" aria-label="Personal brand signals">{signals.map((signal) => <div class={`signal signal-${signal.tone}`}><strong>{signal.number}</strong><span>{signal.labelEn}</span><small>{signal.detailEn}</small></div>)}</section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">02 / SELECTED WORK</div><h2>Selected projects</h2></div><p>Projects with source links, verification evidence, and explicit limitations.</p></div><div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} lang="en" />)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">03 / CAPABILITIES</div><h2>What I work on</h2></div><p>Capability groups backed by public project evidence, not a badge wall.</p></div><div class="capability-grid">{capabilities.map((capability) => <article class={`capability capability-${capability.tone}`}><span class="capability-number">{capability.number}</span><h3>{capability.titleEn}</h3><p>{capability.detailEn}</p></article>)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">04 / CURRENT FOCUS</div><h2>What I am building now</h2></div></div><ul class="focus-list">{focusItems.map((item) => <li><span class="focus-index">{item.number}</span><div><strong>{item.titleEn}</strong>{item.detailEn}</div></li>)}</ul></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">05 / WORKFLOW</div><h2>How I turn ideas into shipped work</h2></div><p>From facts to systems, then to evidence you can inspect.</p></div><div class="workflow-grid">{workflowSteps.map((step) => <article class={`workflow-step workflow-${step.tone}`}><span class="workflow-number">{step.number}</span><h3>{step.titleEn}</h3><p>{step.detailEn}</p></article>)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">06 / NOTES</div><h2>Engineering notes</h2></div><p>Keeping the reasoning, validation, and boundaries behind the projects.</p></div><div class="note-banner"><div><span class="mini-label">FIELD NOTES</span><h3>Turn the work into evidence you can revisit.</h3></div><div class="actions"><a class="button primary" href="/en/notes/">Browse notes →</a><a class="button" href="https://github.com/Dithob" target="_blank" rel="noreferrer">GitHub ↗</a></div></div></section>
</BaseLayout>
