---
import { site } from '../data';

interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  path?: string;
}

const { title, description, lang = 'zh', path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site ?? site.website).toString();
const alternatePath = lang === 'zh' ? `/en${path === '/' ? '/' : path}` : path.replace(/^\/en(?=\/|$)/, '') || '/';
const alternate = new URL(alternatePath, Astro.site ?? site.website).toString();
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og.svg', Astro.site ?? site.website).toString()} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳转到主要内容' : 'Skip to main content'}</a>
    <header class="site-header">
      <nav class="nav shell" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
        <a class="brand" href={lang === 'zh' ? '/' : '/en/'}>D<span>/</span>wujue</a>
        <div class="nav-links">
          <a href={lang === 'zh' ? '/projects/' : '/en/projects/'}>{lang === 'zh' ? '项目' : 'Projects'}</a>
          <a href={lang === 'zh' ? '/resume/' : '/en/resume/'}>{lang === 'zh' ? '简历' : 'Resume'}</a>
          <a href={lang === 'zh' ? '/notes/' : '/en/notes/'}>{lang === 'zh' ? '笔记' : 'Notes'}</a>
          <a href={lang === 'zh' ? '/about/' : '/en/about/'}>{lang === 'zh' ? '关于' : 'About'}</a>
          <a class="language-toggle" href={alternatePath}>{lang === 'zh' ? 'EN' : '中'}</a>
          <button class="theme-toggle" type="button" aria-label={lang === 'zh' ? '切换主题' : 'Toggle theme'} data-theme-toggle>◐</button>
        </div>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div><strong>Dithob</strong><span> · </span>{lang === 'zh' ? '构建可运行、可解释、可核验的 AI 工具。' : 'Building runnable, explainable, and verifiable AI tools.'}</div>
      <div class="footer-links">
        <a href={site.github} rel="me">GitHub</a>
        <a href="mailto:YOUR_PUBLIC_EMAIL">Email</a>
        <span>© 2026</span>
      </div>
    </footer>
    <script is:inline>
      const key = 'dithob-theme';
      const root = document.documentElement;
      const saved = localStorage.getItem(key);
      if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem(key, next);
      });
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --bg: #f5f7fa; --surface: #ffffff; --surface-soft: #eef4f7; --text: #101828; --muted: #52606d; --subtle: #829ab1; --line: #d9e2ec; --accent: #1677a8; --accent-soft: #dff5ff; --warm: #9a5b13; --shadow: 0 16px 40px rgba(16, 24, 40, .08); }
  :root[data-theme='dark'] { color-scheme: dark; --bg: #0b1220; --surface: #111b2e; --surface-soft: #15253b; --text: #f5f7fa; --muted: #bcccdc; --subtle: #829ab1; --line: #2b3c55; --accent: #7dd3fc; --accent-soft: #173b50; --warm: #f6c177; --shadow: 0 18px 45px rgba(0, 0, 0, .22); }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.65; }
  a { color: inherit; text-decoration-color: var(--line); text-underline-offset: .2em; }
  a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -4rem; padding: .6rem 1rem; background: var(--text); color: var(--bg); z-index: 10; }
  .skip-link:focus { top: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(16px); border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent); }
  .nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 750; letter-spacing: -.03em; text-decoration: none; }
  .brand span { color: var(--accent); }
  .nav-links { display: flex; align-items: center; gap: 1.15rem; color: var(--muted); font-size: .94rem; }
  .nav-links a { text-decoration: none; }
  .language-toggle { padding: .25rem .5rem; border: 1px solid var(--line); border-radius: 999px; }
  .theme-toggle { border: 1px solid var(--line); color: var(--text); background: var(--surface); border-radius: 999px; width: 2rem; height: 2rem; cursor: pointer; }
  .hero { padding: 8rem 0 5rem; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); gap: 4rem; align-items: end; }
  .eyebrow { color: var(--accent); font-size: .82rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3 { line-height: 1.12; letter-spacing: -.04em; }
  h1 { font-size: clamp(3rem, 7vw, 6.6rem); margin: .7rem 0 1.5rem; max-width: 10ch; }
  h2 { font-size: clamp(2rem, 4vw, 3.2rem); margin: 0 0 1rem; }
  h3 { font-size: 1.2rem; margin: 0 0 .6rem; }
  .lead { max-width: 700px; font-size: clamp(1.15rem, 2vw, 1.45rem); color: var(--muted); }
  .hero-aside { border-left: 1px solid var(--line); padding-left: 1.5rem; color: var(--muted); }
  .hero-aside strong { display: block; color: var(--text); margin-bottom: .5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .button { display: inline-flex; align-items: center; gap: .5rem; padding: .72rem 1rem; border: 1px solid var(--line); border-radius: .7rem; text-decoration: none; font-weight: 700; background: var(--surface); }
  .button.primary { background: var(--text); color: var(--bg); border-color: var(--text); }
  .section { padding: 5.5rem 0; border-top: 1px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .section-heading p { max-width: 480px; margin: 0; color: var(--muted); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .project-card { display: flex; flex-direction: column; gap: 1rem; min-height: 270px; padding: 1.35rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); box-shadow: var(--shadow); }
  .project-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--subtle); font-size: .85rem; }
  .project-card p { color: var(--muted); margin: 0; }
  .stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: auto; }
  .tag { padding: .25rem .5rem; border-radius: 999px; background: var(--surface-soft); color: var(--muted); font-size: .78rem; }
  .card-links { display: flex; gap: 1rem; font-size: .9rem; font-weight: 700; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .capability { padding: 1.3rem; border-top: 3px solid var(--accent); background: var(--surface); }
  .capability p { color: var(--muted); margin-bottom: 0; }
  .focus-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; list-style: none; }
  .focus-list li { padding: 1rem 0; border-bottom: 1px solid var(--line); color: var(--muted); }
  .focus-list strong { color: var(--text); display: block; }
  .page-intro { padding: 6rem 0 3.5rem; max-width: 780px; }
  .page-intro p { font-size: 1.2rem; color: var(--muted); }
  .content-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 3rem; }
  .prose h2 { margin-top: 2.4rem; }
  .prose p, .prose li { color: var(--muted); }
  .facts { padding: 1.3rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); height: fit-content; }
  .facts dt { color: var(--subtle); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin-top: 1rem; }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: .25rem 0 0; }
  .list-grid { display: grid; gap: 1rem; }
  .note-card { padding: 1.25rem; border-left: 3px solid var(--accent); background: var(--surface); }
  .note-card small { color: var(--accent); font-weight: 700; }
  .note-card p { color: var(--muted); margin-bottom: 0; }
  .site-footer { padding: 2rem 0 3rem; display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .9rem; }
  .footer-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .not-found { min-height: 65vh; display: grid; place-items: center; text-align: center; }
  @media (max-width: 780px) { .shell { width: min(100% - 28px, 680px); } .nav { min-height: 62px; } .nav-links { gap: .7rem; font-size: .84rem; } .hero { padding: 5rem 0 3.5rem; grid-template-columns: 1fr; gap: 2rem; } .hero-aside { border-left: 0; border-top: 1px solid var(--line); padding: 1.2rem 0 0; } .section { padding: 3.5rem 0; } .section-heading { display: block; } .project-grid, .capability-grid, .focus-list, .content-grid { grid-template-columns: 1fr; } .site-footer { display: block; } .footer-links { margin-top: 1rem; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; animation: none !important; } }
</style>
