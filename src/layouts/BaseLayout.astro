---
import { site, themes } from '../data';

interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  path?: string;
  alternatePath?: string;
}

const { title, description, lang = 'zh', path = '/', alternatePath: alternateProp } = Astro.props;
const canonical = new URL(path, Astro.site ?? site.website).toString();
const alternatePath = alternateProp ?? (lang === 'zh' ? `/en${path === '/' ? '/' : path}` : path.replace(/^\/en(?=\/|$)/, '') || '/');
const alternate = new URL(alternatePath, Astro.site ?? site.website).toString();
const themeOptions = themes;
const isHome = path === '/' || path === '/en/';
const navItems = [
  { key: 'projects', href: lang === 'zh' ? '/projects/' : '/en/projects/', label: lang === 'zh' ? '项目' : 'Projects', icon: '🧩' },
  { key: 'notes', href: lang === 'zh' ? '/notes/' : '/en/notes/', label: lang === 'zh' ? '文章' : 'Articles', icon: '📚' },
  { key: 'about', href: lang === 'zh' ? '/about/' : '/en/about/', label: lang === 'zh' ? '关于' : 'About', icon: '👤' },
];
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'wujue / Dithob',
  url: site.website,
  sameAs: [site.github],
  email: `mailto:${site.mail}`,
});
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site ?? site.website).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={personJsonLd} is:inline />}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const key = 'dithob-visual-theme-v2';
        const root = document.documentElement;
        const defaultTheme = 'neo-brutalist';
        const validThemes = ['neo-brutalist', 'editorial', 'minimalist-flat', 'bento-grid', 'geometric-bold'];
        const saved = localStorage.getItem(key);
        const next = validThemes.includes(saved) ? saved : defaultTheme;
        root.dataset.theme = next;
        localStorage.setItem(key, next);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳转到主要内容' : 'Skip to main content'}</a>
    <header class="site-header">
      <nav class="nav shell" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
        <a class="brand" href={lang === 'zh' ? '/' : '/en/'}>D<span>/</span>wujue</a>
        <div class="nav-links">
          {navItems.map((item) => (
            <a href={item.href} aria-label={item.label} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">{item.icon}</span>
              <span class="nav-text">{item.label}</span>
            </a>
          ))}
          <a class="language-toggle" href={alternatePath}>{lang === 'zh' ? 'EN' : '中'}</a>
        </div>
        <div class="nav-actions">
          <button class="nav-search-button" type="button" data-search-open aria-label={lang === 'zh' ? '搜索（按 / 或 ⌘K）' : 'Search (press / or ⌘K)'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <span class="nav-search-text">{lang === 'zh' ? '搜索' : 'Search'}</span>
            <kbd class="nav-search-kbd">/</kbd>
          </button>
          <a class="nav-icon-link" href={site.github} target="_blank" rel="me noreferrer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          </a>
          <a class="nav-icon-link nav-icon-mail" href={`mailto:${site.mail}`} aria-label={site.mail} title={site.mail}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </a>
          <button class="theme-toggle" type="button" aria-label={lang === 'zh' ? '打开风格切换' : 'Open style switcher'} aria-expanded="false" aria-controls="theme-menu" data-theme-toggle>◐</button>
        </div>
      </nav>
      <div class="theme-menu shell" id="theme-menu" data-theme-menu hidden>
        <div class="theme-menu-heading">
          <div>
            <span class="mini-label">{lang === 'zh' ? 'VISUAL SYSTEM' : 'VISUAL SYSTEM'}</span>
            <strong>{lang === 'zh' ? '选择你的主页气质' : 'Choose a visual direction'}</strong>
          </div>
          <span class="theme-current" data-theme-current></span>
        </div>
        <ul class="theme-options">
          {themeOptions.map((theme) => (
            <li>
              <button
                class={`theme-option theme-option-${theme.id}`}
                type="button"
                data-theme-option={theme.id}
                aria-pressed="false"
              >
                <span class="theme-option-mark">{lang === 'zh' ? theme.short : theme.shortEn}</span>
                <span>
                  <strong>{lang === 'zh' ? theme.label : theme.labelEn}</strong>
                  <small>{lang === 'zh' ? theme.labelEn : theme.label}</small>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <div class="search-overlay" data-search-overlay hidden>
      <div class="search-panel" role="dialog" aria-modal="true" aria-label={lang === 'zh' ? '站内搜索' : 'Site search'}>
        <div class="search-input-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" data-search-input placeholder={lang === 'zh' ? '搜索项目、文章、页面…' : 'Search projects, articles, pages…'} autocomplete="off" spellcheck="false" />
          <kbd class="search-esc">ESC</kbd>
        </div>
        <ul class="search-results" data-search-results></ul>
        <div class="search-empty" data-search-empty hidden>{lang === 'zh' ? '没有匹配的结果' : 'No matching results'}</div>
      </div>
    </div>
    <footer class="site-footer shell">
      <div><strong>Dithob</strong><span> · </span>{lang === 'zh' ? '把生成交给 AI，把判断留给人。' : 'AI generates. Humans judge.'}</div>
      <div class="footer-links">
        <a href={site.github} rel="me">GitHub</a>
        <a href={`mailto:${site.mail}`} class="footer-mail">{site.mail}</a>
        <span>© 2026</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const key = 'dithob-visual-theme-v2';
        const legacyKey = 'dithob-visual-theme';
        const root = document.documentElement;
        const defaultTheme = 'neo-brutalist';
        const validThemes = ['neo-brutalist', 'editorial', 'minimalist-flat', 'bento-grid', 'geometric-bold'];
        if (legacyKey) localStorage.removeItem(legacyKey);
        const saved = localStorage.getItem(key);
        const setTheme = (theme) => {
        const next = validThemes.includes(theme) ? theme : defaultTheme;
        root.dataset.theme = next;
        localStorage.setItem(key, next);
        document.querySelectorAll('[data-theme-option]').forEach((option) => {
          option.setAttribute('aria-pressed', option.dataset.themeOption === next ? 'true' : 'false');
        });
        const current = document.querySelector('[data-theme-current]');
        const selected = document.querySelector(`[data-theme-option="${next}"] strong`);
        if (current) current.textContent = selected?.textContent?.trim() || next.replaceAll('-', ' ').toUpperCase();
      };
      setTheme(saved || defaultTheme);
      const menu = document.querySelector('[data-theme-menu]');
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const open = menu?.hasAttribute('hidden');
        if (open) {
          menu?.removeAttribute('hidden');
        } else {
          menu?.setAttribute('hidden', '');
        }
        toggle?.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('[data-theme-option]').forEach((option) => {
        option.addEventListener('click', () => {
          setTheme(option.dataset.themeOption || defaultTheme);
          menu?.setAttribute('hidden', '');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu?.setAttribute('hidden', '');
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });
      })();
    </script>
    <script is:inline>
      (() => {
        const openBtn = document.querySelector('[data-search-open]');
        const overlay = document.querySelector('[data-search-overlay]');
        const input = overlay?.querySelector('[data-search-input]');
        const results = overlay?.querySelector('[data-search-results]');
        const empty = overlay?.querySelector('[data-search-empty]');
        if (!openBtn || !overlay || !input || !results || !empty) return;
        let indexPromise = null;
        let matches = [];
        let active = -1;
        const loadIndex = () => (indexPromise ??= fetch('/search-index.json').then((r) => r.json()).catch(() => []));
        const norm = (s) => String(s || '').toLowerCase().trim();
        const search = (query) => {
          const q = norm(query);
          if (!q) return [];
          return indexPromise ? indexPromise.then((entries) => {
            matches = entries
              .map((entry) => {
                const hay = norm(`${entry.title} ${entry.description} ${entry.category}`);
                if (!hay.includes(q)) return null;
                const title = norm(entry.title);
                const score = title.startsWith(q) ? 10 : title.includes(q) ? 6 : 3 + (norm(entry.category).includes(q) ? 1 : 0);
                return { ...entry, score };
              })
              .filter(Boolean)
              .sort((a, b) => b.score - a.score)
              .slice(0, 8);
            render();
          }) : [];
        };
        const render = () => {
          results.replaceChildren();
          active = -1;
          empty.hidden = matches.length > 0;
          matches.forEach((entry, i) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = entry.url;
            const strong = document.createElement('strong');
            strong.textContent = entry.title;
            const small = document.createElement('small');
            small.textContent = entry.category;
            const p = document.createElement('p');
            p.textContent = entry.description;
            a.append(strong, small, p);
            li.dataset.index = String(i);
            li.append(a);
            results.append(li);
          });
        };
        const open = async () => {
          overlay.hidden = false;
          document.body.style.overflow = 'hidden';
          input.value = '';
          const entries = await loadIndex();
          matches = entries.slice(0, 8);
          render();
          input.focus();
        };
        const close = () => {
          overlay.hidden = true;
          document.body.style.overflow = '';
          if (input === document.activeElement) input.blur();
        };
        const setActive = (next) => {
          active = (next + matches.length) % matches.length;
          results.querySelectorAll('li').forEach((li, i) => li.classList.toggle('active', i === active));
          results.querySelector('li.active a')?.focus();
        };
        openBtn.addEventListener('click', open);
        input.addEventListener('input', () => search(input.value));
        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') { event.preventDefault(); setActive(active + 1); }
          else if (event.key === 'ArrowUp') { event.preventDefault(); setActive(active - 1); }
          else if (event.key === 'Enter') { const href = results.querySelector(`li[data-index="${active}"] a`)?.getAttribute('href'); if (href) window.location.href = href; }
          else if (event.key === 'Escape') close();
        });
        results.addEventListener('click', (event) => { if (event.target.closest('a')) close(); });
        overlay.addEventListener('click', (event) => { if (event.target === overlay) close(); });
        document.addEventListener('keydown', (event) => {
          const typing = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName);
          if ((event.key === '/' && !typing) || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
            event.preventDefault();
            overlay.hidden ? open() : close();
          } else if (event.key === 'Escape' && !overlay.hidden) {
            close();
          }
        });
      })();
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --bg: #fffdf7; --surface: #ffffff; --surface-soft: #f4f0e6; --text: #080808; --muted: #313131; --subtle: #646464; --line: #080808; --accent: #ff006e; --accent-soft: #ff006e; --warm: #ff9500; --pink: #ff006e; --lime: #ccff00; --blue: #00d9ff; --orange: #ff9500; --purple: #a78bfa; --red: #ff4d4d; --shadow: 8px 8px 0 #080808; --shadow-small: 4px 4px 0 #080808; --heading-font: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; --body-font: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
  :root[data-theme='editorial'] { --bg: #f5f0e8; --surface: #fbf8f2; --surface-soft: #e4ddd0; --text: #17130f; --muted: #625a50; --subtle: #6b6054; --line: #17130f; --accent: #a43b28; --accent-soft: #a43b28; --warm: #c8a05a; --pink: #a43b28; --lime: #d6c29a; --blue: #38536c; --orange: #c47b3c; --purple: #6d586f; --red: #a43b28; --shadow: 8px 8px 0 #17130f; --shadow-small: 3px 3px 0 #17130f; --heading-font: Georgia, "Times New Roman", serif; --body-font: Arial, Helvetica, sans-serif; }
  :root[data-theme='minimalist-flat'] { --bg: #ffffff; --surface: #ffffff; --surface-soft: #f2f2f2; --text: #050505; --muted: #3c3c3c; --subtle: #777777; --line: #050505; --accent: #ff3366; --accent-soft: #ff3366; --warm: #ffcc00; --pink: #ff3366; --lime: #ffcc00; --blue: #00d4aa; --orange: #ffcc00; --purple: #6557d2; --red: #ff3366; --shadow: none; --shadow-small: none; --heading-font: Arial, Helvetica, sans-serif; --body-font: Arial, Helvetica, sans-serif; }
  :root[data-theme='bento-grid'] { color-scheme: light; --bg: #ffffff; --surface: #ffffff; --surface-soft: #f7f8fa; --text: #151515; --muted: #5f6368; --subtle: #9298a1; --line: #e5e7eb; --accent: #2563eb; --accent-soft: #2563eb; --warm: #f59e0b; --pink: #2563eb; --lime: #e9eef7; --blue: #2563eb; --orange: #f59e0b; --purple: #7c3aed; --red: #dc2626; --shadow: 0 14px 30px rgba(17, 24, 39, .06); --shadow-small: 0 5px 14px rgba(17, 24, 39, .05); --heading-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif; --body-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif; }
  :root[data-theme='geometric-bold'] { color-scheme: dark; --bg: #090909; --surface: #111111; --surface-soft: #1a1a1a; --text: #f5f5f5; --muted: #b8b8b8; --subtle: #7c7c7c; --line: #eeeeee; --accent: #c8ff00; --accent-soft: #c8ff00; --warm: #ffb000; --pink: #c8ff00; --lime: #c8ff00; --blue: #8ee7ff; --orange: #ffb000; --purple: #b7a5ff; --red: #ff6b8a; --shadow: none; --shadow-small: none; --heading-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif; --body-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif; }
  :root[data-theme='neo-brutalist'] { color-scheme: light; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--body-font); line-height: 1.55; }
  a { color: inherit; text-decoration-color: var(--line); text-underline-offset: .2em; }
  a:hover { color: var(--pink); text-decoration-color: currentColor; }
  .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -4rem; padding: .6rem 1rem; background: var(--text); color: var(--bg); z-index: 10; border: 3px solid var(--line); box-shadow: var(--shadow-small); }
  .skip-link:focus { top: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 3px solid var(--line); }
  .nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { font-family: var(--heading-font); font-weight: 950; letter-spacing: -.08em; text-decoration: none; font-size: 1.05rem; }
  .brand span { color: var(--pink); }
  .nav-links { display: flex; align-items: center; gap: 0; color: var(--text); font-size: .82rem; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; margin-left: auto; }
  .nav-links a { text-decoration: none; }
  .nav-links > a { padding: .7rem .8rem; border-left: 3px solid var(--line); display: inline-flex; align-items: center; gap: .35rem; }
  .nav-links > a:hover { background: var(--lime); color: var(--text); }
  .nav-icon { font-size: 1em; line-height: 1; }
  .nav-links > a[aria-current='page'] { background: var(--surface-soft); text-decoration: underline; text-underline-offset: .25em; }
  .language-toggle { background: var(--pink); color: var(--text); }
  .theme-toggle { border: 3px solid var(--line); color: var(--text); background: var(--surface); width: 2.4rem; height: 2.4rem; cursor: pointer; margin-left: .8rem; box-shadow: var(--shadow-small); font-weight: 950; }
  .theme-toggle:active, .button:active { transform: translate(4px, 4px); box-shadow: none; }
  .nav-actions { display: flex; align-items: center; gap: .55rem; }
  .nav-actions .theme-toggle { margin-left: .4rem; }
  .nav-search-button { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .7rem; border: 3px solid var(--line); background: var(--surface); color: var(--muted); cursor: pointer; box-shadow: var(--shadow-small); font-family: var(--body-font); font-size: .78rem; font-weight: 900; }
  .nav-search-button:hover { background: var(--lime); color: var(--text); }
  .nav-search-button svg { width: .95rem; height: .95rem; }
  .nav-search-button .nav-search-text { white-space: nowrap; }
  .nav-search-kbd, .search-esc { font-family: var(--heading-font); font-size: .62rem; padding: .1rem .35rem; border: 2px solid var(--line); color: var(--subtle); background: var(--bg); }
  .nav-icon-link { display: inline-flex; align-items: center; justify-content: center; width: 2.3rem; height: 2.3rem; border: 3px solid var(--line); color: var(--text); background: var(--surface); box-shadow: var(--shadow-small); text-decoration: none; }
  .nav-icon-link:hover { background: var(--blue); color: var(--text); }
  .nav-icon-link svg { width: 1.1rem; height: 1.1rem; }
  .search-overlay { position: fixed; inset: 0; z-index: 30; display: flex; justify-content: center; align-items: flex-start; padding: clamp(4rem, 12vh, 8rem) 1rem 2rem; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(6px); }
  .search-overlay[hidden] { display: none; }
  .search-panel { width: min(640px, 100%); max-height: min(72vh, 540px); display: flex; flex-direction: column; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  .search-input-row { display: flex; align-items: center; gap: .6rem; padding: .9rem 1rem; border-bottom: 3px solid var(--line); }
  .search-input-row svg { width: 1.15rem; height: 1.15rem; color: var(--muted); flex: 0 0 auto; }
  .search-input-row input { flex: 1 1 auto; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font-family: var(--body-font); font-size: 1.05rem; font-weight: 750; }
  .search-input-row input::placeholder { color: var(--subtle); font-weight: 600; }
  .search-results { margin: 0; padding: .35rem; list-style: none; overflow-y: auto; }
  .search-results a { display: block; padding: .55rem .7rem; text-decoration: none; }
  .search-results a:hover, .search-results li.active a { background: var(--lime); color: var(--text); }
  .search-results strong { display: block; font-weight: 950; }
  .search-results small { display: inline-block; margin-top: .1rem; color: var(--pink); font-size: .66rem; font-weight: 950; letter-spacing: .1em; text-transform: uppercase; }
  .search-results p { margin: .15rem 0 0; color: var(--muted); font-size: .82rem; font-weight: 700; }
  .search-empty { padding: 1.2rem 1rem; color: var(--muted); text-align: center; font-weight: 700; }
  .theme-menu { position: absolute; top: calc(100% + 1rem); left: 50%; transform: translateX(-50%); z-index: 8; padding: 1rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  .theme-menu[hidden] { display: none; }
  .theme-menu-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1rem; }
  .theme-menu-heading strong { display: block; margin-top: .35rem; font-family: var(--heading-font); font-size: 1.3rem; }
  .theme-current { color: var(--accent); font-size: .72rem; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  .theme-options { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .theme-options > li { display: grid; }
  .theme-option { display: grid; gap: .7rem; min-height: 112px; padding: .8rem; border: 3px solid var(--line); color: var(--text); background: var(--bg); text-align: left; cursor: pointer; box-shadow: var(--shadow-small); font-family: var(--body-font); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .theme-option:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--accent); }
  .theme-option[aria-pressed='true'] { outline: 4px solid var(--accent); outline-offset: 2px; }
  .theme-option strong, .theme-option small { display: block; }
  .theme-option strong { font-family: var(--heading-font); font-size: .87rem; }
  .theme-option small { margin-top: .2rem; color: var(--subtle); font-size: .66rem; font-weight: 800; }
  .theme-option-mark { display: block; width: fit-content; min-width: 3.3rem; padding: .35rem .45rem; border: 2px solid var(--line); font-size: .72rem; font-weight: 950; letter-spacing: .08em; background: var(--text); color: var(--bg); }
  .theme-option-editorial { background: #f5f0e8; }
  .theme-option-editorial .theme-option-mark { background: #a43b28; color: #f5f0e8; }
  .theme-option-minimalist-flat { background: #ffffff; }
  .theme-option-minimalist-flat .theme-option-mark { background: #ff3366; }
  .theme-option-bento-grid { background: #ffffff; }
  .theme-option-bento-grid .theme-option-mark { background: #2563eb; color: #ffffff; }
  .theme-option-geometric-bold { background: #090909; color: #f5f5f5; }
  .theme-option-geometric-bold .theme-option-mark { background: #c8ff00; color: #090909; border-color: #f5f5f5; }
  .hero { position: relative; padding: 6.8rem 0 4.8rem; display: grid; grid-template-columns: minmax(0, 1.32fr) minmax(280px, .68fr); gap: 3rem; align-items: end; border-bottom: 3px solid var(--line); }
  .hero::before { content: ''; position: absolute; inset: 2rem 0 auto; height: 1.2rem; border-block: 3px dashed var(--line); opacity: .9; }
  .hero-content { position: relative; z-index: 1; }
  .hero-content h1 { font-size: clamp(2.4rem, 5.2vw, 5rem); max-width: 16ch; }
  .hero-kicker, .section-code, .mini-label { color: var(--text); font-size: .78rem; font-weight: 950; letter-spacing: .1em; text-transform: uppercase; }
  .hero-kicker { display: inline-flex; gap: .75rem; align-items: center; padding: .55rem .8rem; background: var(--lime); border: 3px solid var(--line); box-shadow: var(--shadow-small); }
  .hero-kicker span { color: var(--pink); }
  .eyebrow { color: var(--pink); font-size: .82rem; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3 { font-family: var(--heading-font); line-height: 1.02; letter-spacing: -.08em; font-weight: 950; }
  h1 { font-size: clamp(3.4rem, 8vw, 7.4rem); margin: 1.3rem 0 1.5rem; max-width: 9ch; }
  h2 { font-size: clamp(2.4rem, 5vw, 4.3rem); margin: .5rem 0 1rem; }
  h3 { font-size: 1.3rem; margin: 0 0 .6rem; }
  .lead { max-width: 720px; font-size: clamp(1rem, 1.7vw, 1.25rem); color: var(--muted); font-weight: 700; }
  .hero-aside { position: relative; border: 3px solid var(--line); padding: 1.4rem; color: var(--text); background: var(--blue); box-shadow: var(--shadow); }
  .hero-stamp { position: absolute; right: .8rem; top: -.85rem; background: var(--pink); border: 3px solid var(--line); padding: .3rem .55rem; font-size: 1.6rem; font-weight: 950; transform: rotate(3deg); box-shadow: var(--shadow-small); }
  .hero-aside-block { border-bottom: 3px solid var(--line); padding: .4rem 0 1rem; margin-bottom: 1rem; }
  .hero-aside-block p { margin: .45rem 0 0; font-weight: 850; }
  .hero-aside-code { font-size: .75rem; font-weight: 950; line-height: 1.7; }
  .hero-corner { position: absolute; right: 0; bottom: .8rem; color: var(--pink); font-size: .7rem; font-weight: 950; letter-spacing: .12em; transform: rotate(-90deg) translateX(100%); transform-origin: right bottom; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .button { display: inline-flex; align-items: center; gap: .5rem; padding: .78rem 1rem; border: 3px solid var(--line); text-decoration: none; font-weight: 950; background: var(--surface); box-shadow: var(--shadow-small); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .button:hover { background: var(--lime); color: var(--text); transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pink); }
  .button.primary { background: var(--text); color: var(--bg); border-color: var(--line); }
  .button.primary:hover { background: var(--pink); color: var(--text); }
  .section { padding: 5.5rem 0; border-top: 3px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .section-code { color: var(--pink); }
  .section-heading p { max-width: 480px; margin: 0; color: var(--muted); }
  .signal-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-inline: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .signal { display: grid; grid-template-columns: auto 1fr; gap: .3rem .8rem; padding: 1rem; border-right: 3px solid var(--line); color: var(--text); }
  .signal:last-child { border-right: 0; }
  .signal strong { font-size: 1.6rem; line-height: 1; }
  .signal span { font-weight: 950; align-self: end; }
  .signal small { grid-column: 2; font-size: .65rem; font-weight: 950; letter-spacing: .1em; }
  .signal-pink { background: var(--pink); }
  .signal-lime { background: var(--lime); }
  .signal-blue { background: var(--blue); }
  .signal-orange { background: var(--orange); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem; }
  .project-card { position: relative; display: flex; flex-direction: column; gap: 1rem; min-height: 310px; padding: 1.35rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .project-card:hover { transform: translate(-4px, -4px); box-shadow: 12px 12px 0 var(--pink); background: var(--lime); }
  .project-meta { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .7rem; color: var(--subtle); font-size: .73rem; font-weight: 950; text-transform: uppercase; }
  .project-code { color: var(--pink); }
  .project-accent { display: block; height: 8px; background: var(--pink); }
  .accent-pink { background: var(--pink); }
  .accent-lime { background: var(--lime); }
  .accent-blue { background: var(--blue); }
  .accent-orange { background: var(--orange); }
  .accent-purple { background: var(--purple); }
  .accent-red { background: var(--red); }
  .project-status { text-align: right; white-space: nowrap; }
  .project-card h3 { font-size: 1.6rem; margin-bottom: .35rem; }
  .project-card h3 a { text-decoration: none; }
  .project-category { display: inline-block; color: var(--text); font-size: .72rem; font-weight: 950; margin-bottom: .75rem; border-bottom: 3px solid var(--pink); }
  .project-card p { color: var(--muted); margin: 0; font-weight: 700; }
  .stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: auto; }
  .tag { padding: .25rem .5rem; border: 2px solid var(--line); background: var(--bg); color: var(--text); font-size: .72rem; font-weight: 850; }
  .card-links { display: flex; gap: 1rem; font-size: .82rem; font-weight: 950; text-transform: uppercase; }
  .project-proof { display: flex; gap: .55rem; font-size: .66rem; font-weight: 950; letter-spacing: .06em; text-transform: uppercase; }
  .project-proof span { padding: .25rem .4rem; border: 2px solid var(--line); background: var(--pink); color: var(--text); }
  .project-proof span:last-child { background: var(--blue); }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .capability { position: relative; min-height: 180px; padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); }
  .capability-pink { background: var(--pink); }
  .capability-lime { background: var(--lime); }
  .capability-blue { background: var(--blue); }
  .capability-number { position: absolute; right: 1rem; top: .7rem; font-size: 1.9rem; font-weight: 950; opacity: .5; }
  .capability p { color: var(--text); margin-bottom: 0; font-weight: 850; }
  .focus-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; list-style: none; }
  .focus-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 3px solid var(--line); color: var(--muted); font-weight: 700; }
  .focus-list strong { color: var(--text); display: block; margin-bottom: .35rem; font-weight: 950; }
  .focus-index { color: var(--pink); font-size: 1.6rem; font-weight: 950; }
  .workflow-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .workflow-step { position: relative; min-height: 190px; padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); }
  .workflow-pink { background: var(--pink); }
  .workflow-lime { background: var(--lime); }
  .workflow-blue { background: var(--blue); }
  .workflow-number { display: block; color: var(--text); font-size: 1.7rem; font-weight: 950; }
  .workflow-step h3 { margin-top: 2.2rem; }
  .workflow-step p { color: var(--text); margin-bottom: 0; font-weight: 750; }
  .note-banner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 1.4rem; border: 3px solid var(--line); background: var(--orange); box-shadow: var(--shadow); }
  .note-banner h3 { margin: .5rem 0 0; max-width: 20ch; }
  .page-intro { padding: 6rem 0 3.5rem; max-width: 780px; }
  .page-intro h1 { max-width: 100%; overflow-wrap: anywhere; word-break: break-word; }
  .page-intro p { font-size: 1.2rem; color: var(--muted); }
  .content-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 3rem; }
  .prose h2 { margin-top: 2.4rem; }
  .prose p, .prose li { color: var(--muted); }
  .facts { padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); height: fit-content; }
  .facts dt { color: var(--subtle); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin-top: 1rem; }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: .25rem 0 0; }
  .list-grid { display: grid; gap: 1rem; }
  .note-group + .note-group { margin-top: 2.6rem; }
  .note-group-title { font-size: 1.1rem; margin: 0 0 1rem; padding-bottom: .5rem; border-bottom: 3px solid var(--accent); }
  .note-card { padding: 1.25rem; border: 3px solid var(--line); box-shadow: var(--shadow-small); background: var(--surface); }
  .note-card:nth-child(1) { background: var(--pink); }
  .note-card:nth-child(2) { background: var(--blue); }
  .note-card:nth-child(3) { background: var(--lime); }
  .note-card:nth-child(4) { background: var(--orange); }
  .note-card small { color: var(--text); font-weight: 950; }
  .note-card p { color: var(--text); margin-bottom: 0; font-weight: 700; }
  .note-card-title { margin: .6rem 0 .5rem; }
  .note-card-plain { background: var(--surface) !important; }

  /* Resume entries (online resume page). */
  .resume-entry { margin-top: 1.8rem; }
  .resume-entry-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; align-items: baseline; }
  .resume-entry-heading h3 { margin: 0; font-size: 1.15rem; }
  .resume-entry-heading .resume-org { color: var(--muted); font-size: .95rem; }
  .resume-entry-date { color: var(--subtle); font-size: .78rem; font-weight: 900; letter-spacing: .04em; white-space: nowrap; }
  .resume-entry ul { margin: .7rem 0 0; }
  .resume-contact-list { display: grid; gap: .5rem; }
  .resume-contact-list .button { width: fit-content; }

  /* Prose (notes + articles): tables, quotes, code, headings. */
  .prose { overflow-wrap: anywhere; }
  .prose h2 { margin-top: 2.4rem; scroll-margin-top: 6rem; }
  .prose h3 { margin-top: 2rem; scroll-margin-top: 6rem; }
  .prose h4 { margin-top: 1.6rem; scroll-margin-top: 6rem; }
  .prose p, .prose li { color: var(--muted); }
  .prose p { margin: 1rem 0; }
  .prose ul, .prose ol { padding-left: 1.5rem; }
  .prose li { margin: .4rem 0; }
  .prose a { word-break: break-word; }
  .prose blockquote { margin: 1.4rem 0; padding: 1rem 1.2rem; border-left: 6px solid var(--accent); background: var(--surface-soft); }
  .prose blockquote p { margin: 0; color: var(--muted); }
  .prose blockquote p + p { margin-top: .6rem; }
  .prose :not(pre) > code { font-family: var(--heading-font); font-size: .85em; padding: .1em .35em; background: var(--surface-soft); border: 1px solid var(--line); }
  .prose pre { margin: 1.4rem 0; padding: 1rem; border: 3px solid var(--line); box-shadow: var(--shadow-small); overflow-x: auto; }
  .prose pre code { padding: 0; font-size: .85rem; }
  .prose hr { border: 0; border-top: 3px solid var(--line); margin: 2.2rem 0; }
  .prose table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.4rem 0; font-size: .9rem; }
  .prose th, .prose td { border: 3px solid var(--line); padding: .5rem .7rem; text-align: left; }
  .prose th { background: var(--surface-soft); }
  .prose thead th { background: var(--text); color: var(--bg); }
  .prose img { max-width: 100%; height: auto; border: 3px solid var(--line); }

  /* Shiki css-variables theme: a dark code card that fits every skin. */
  :root {
    --astro-code-background: #101010;
    --astro-code-foreground: #e8e8e8;
    --astro-code-token-comment: #8b949e;
    --astro-code-token-string: #a5d6ff;
    --astro-code-token-keyword: #ff7b72;
    --astro-code-token-function: #d2a8ff;
    --astro-code-token-number: #79c0ff;
    --astro-code-token-constant: #79c0ff;
    --astro-code-token-attribute: #79c0ff;
    --astro-code-token-operator: #ff7b72;
    --astro-code-token-tag: #7ee787;
    --astro-code-token-property: #79c0ff;
    --astro-code-token-regex: #a5d6ff;
    --astro-code-token-parameter: #e8e8e8;
    --astro-code-token-punctuation: #e8e8e8;
    --astro-code-token-entity: #e8e8e8;
  }
  .site-footer { padding: 2rem 0 3rem; display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .8rem; font-weight: 700; }
  .footer-links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .not-found { min-height: 65vh; display: grid; place-items: center; text-align: center; }

  /* Editorial: magazine hierarchy, restrained rules, serif display type. */
  [data-theme='editorial'] .site-header { border-bottom-width: 1px; }
  [data-theme='editorial'] .nav { min-height: 82px; }
  [data-theme='editorial'] .nav-links { font-family: var(--body-font); font-size: .72rem; letter-spacing: .14em; }
  [data-theme='editorial'] .nav-links > a { border-left: 0; padding: .45rem .7rem; }
  [data-theme='editorial'] .nav-links > a:hover { background: transparent; color: var(--accent); }
  [data-theme='editorial'] .nav-links > a[aria-current='page'] { background: transparent; color: var(--accent); text-decoration: underline; }
  [data-theme='editorial'] .language-toggle { background: transparent; color: var(--accent); border-bottom: 1px solid var(--accent); }
  [data-theme='editorial'] .theme-toggle { border-width: 1px; box-shadow: none; background: transparent; }
  [data-theme='editorial'] .theme-menu { border-width: 1px; box-shadow: 6px 6px 0 var(--line); }
  [data-theme='editorial'] .hero { padding: 8.5rem 0 6rem; gap: 5rem; border-bottom-width: 1px; }
  [data-theme='editorial'] .hero::before { display: none; }
  [data-theme='editorial'] .hero-kicker { padding: 0; border: 0; box-shadow: none; background: transparent; color: var(--accent); letter-spacing: .18em; }
  [data-theme='editorial'] .hero-kicker span { color: var(--accent); }
  [data-theme='editorial'] h1, [data-theme='editorial'] h2, [data-theme='editorial'] h3 { font-weight: 500; letter-spacing: -.075em; }
  [data-theme='editorial'] .lead { font-family: var(--body-font); font-weight: 400; }
  [data-theme='editorial'] .hero-aside { border: 0; border-left: 1px solid var(--line); padding-left: 2rem; background: transparent; box-shadow: none; }
  [data-theme='editorial'] .hero-stamp { background: var(--accent); color: #fff; border: 0; box-shadow: none; transform: none; }
  [data-theme='editorial'] .hero-aside-block { border-bottom-width: 1px; }
  [data-theme='editorial'] .hero-aside-code { color: var(--accent); }
  [data-theme='editorial'] .button { border-width: 1px; box-shadow: none; background: transparent; font-family: var(--body-font); font-weight: 700; }
  [data-theme='editorial'] .button:hover { transform: none; box-shadow: none; background: var(--accent); color: #fff; }
  [data-theme='editorial'] .button.primary { background: var(--text); color: var(--bg); }
  [data-theme='editorial'] .signal-strip { border-inline: 0; border-bottom-width: 1px; }
  [data-theme='editorial'] .signal { background: transparent; border-right-width: 1px; padding: 1.5rem 0; }
  [data-theme='editorial'] .signal strong { color: var(--accent); font-family: var(--heading-font); }
  [data-theme='editorial'] .section { border-top-width: 1px; }
  [data-theme='editorial'] .section-code { color: var(--accent); letter-spacing: .16em; }
  [data-theme='editorial'] .project-grid { gap: 2rem; }
  [data-theme='editorial'] .project-card { min-height: 320px; border: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.5rem 0; background: transparent; box-shadow: none; }
  [data-theme='editorial'] .project-card:hover { transform: none; box-shadow: none; background: transparent; }
  [data-theme='editorial'] .project-accent { height: 2px; background: var(--accent); }
  [data-theme='editorial'] .project-code, [data-theme='editorial'] .project-category { color: var(--accent); }
  [data-theme='editorial'] .tag { border: 0; padding: 0; background: transparent; color: var(--muted); }
  [data-theme='editorial'] .project-proof span { border: 0; border-bottom: 1px solid var(--line); padding: .1rem 0; background: transparent; }
  [data-theme='editorial'] .project-proof span:last-child { background: transparent; color: var(--accent); }
  [data-theme='editorial'] .capability { border: 0; border-top: 1px solid var(--line); padding: 1.2rem 0; background: transparent; box-shadow: none; }
  [data-theme='editorial'] .capability-pink, [data-theme='editorial'] .capability-lime, [data-theme='editorial'] .capability-blue { background: transparent; }
  [data-theme='editorial'] .capability-number { color: var(--accent); }
  [data-theme='editorial'] .workflow-step { border: 0; border-top: 1px solid var(--line); padding: 1.2rem 0; background: transparent; box-shadow: none; }
  [data-theme='editorial'] .workflow-pink, [data-theme='editorial'] .workflow-lime, [data-theme='editorial'] .workflow-blue { background: transparent; }
  [data-theme='editorial'] .workflow-number { color: var(--accent); }
  [data-theme='editorial'] .note-banner { border-inline: 0; border-top-width: 1px; border-bottom-width: 1px; background: transparent; box-shadow: none; }
  [data-theme='editorial'] .note-card { border: 0; border-top: 1px solid var(--line); background: transparent !important; box-shadow: none; }
  [data-theme='editorial'] .facts { border-width: 1px; background: transparent; box-shadow: none; }

  /* Minimalist Flat: reduction, one accent at a time, no depth effects. */
  [data-theme='minimalist-flat'] .site-header { border-bottom-width: 1px; }
  [data-theme='minimalist-flat'] .nav-links { font-family: var(--body-font); }
  [data-theme='minimalist-flat'] .nav-links > a { border-left: 0; padding-inline: .7rem; }
  [data-theme='minimalist-flat'] .nav-links > a:hover { background: transparent; color: var(--accent); }
  [data-theme='minimalist-flat'] .nav-links > a[aria-current='page'] { background: transparent; color: var(--accent); text-decoration: underline; }
  [data-theme='minimalist-flat'] .language-toggle { background: var(--accent); color: #fff; }
  [data-theme='minimalist-flat'] .theme-toggle { border-width: 1px; box-shadow: none; }
  [data-theme='minimalist-flat'] .theme-menu { border-width: 1px; box-shadow: none; }
  [data-theme='minimalist-flat'] .hero { padding: 7rem 0 5rem; border-bottom-width: 1px; }
  [data-theme='minimalist-flat'] .hero::before { display: none; }
  [data-theme='minimalist-flat'] .hero-kicker { padding: 0 0 .55rem; border: 0; border-bottom: 3px solid var(--accent); box-shadow: none; background: transparent; }
  [data-theme='minimalist-flat'] .hero-stamp { background: var(--accent); color: #fff; border-width: 1px; box-shadow: none; transform: none; }
  [data-theme='minimalist-flat'] .hero-aside { border: 0; border-left: 1px solid var(--line); background: transparent; box-shadow: none; }
  [data-theme='minimalist-flat'] .button { border-width: 1px; box-shadow: none; }
  [data-theme='minimalist-flat'] .button:hover { transform: none; box-shadow: none; background: var(--accent); color: #fff; }
  [data-theme='minimalist-flat'] .button.primary { background: var(--text); color: var(--bg); }
  [data-theme='minimalist-flat'] .signal-strip { border-inline: 0; border-bottom-width: 1px; }
  [data-theme='minimalist-flat'] .signal { border-right-width: 1px; background: transparent; }
  [data-theme='minimalist-flat'] .signal-pink { color: var(--accent); }
