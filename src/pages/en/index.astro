---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data';
const featuredProjects = projects.filter((project) => project.featured);
---
<BaseLayout title="wujue / Dithob — AI tools and engineering" description="Building runnable, explainable, and verifiable AI tools." lang="en" path="/en/">
  <section class="hero shell"><div><div class="eyebrow">wujue / Dithob</div><h1>Building runnable, explainable, and verifiable AI tools.</h1><p class="lead">I work across AI applications, agent tooling, RAG/OCR, and engineering quality — turning ideas into systems that can run, explain themselves, and state their limits honestly.</p><div class="actions"><a class="button primary" href="/en/projects/">View projects →</a><a class="button" href="/en/resume/">Resume</a><a class="button" href="/en/notes/">Notes</a></div></div><aside class="hero-aside"><strong>Current focus</strong><p>PaperQAAgent · DeepResume · reusable agent skills</p><strong>How I work</strong><p>Separate verified facts, inference, and external state; ship validation and boundaries with the artifact.</p></aside></section>
  <section class="section shell"><div class="section-heading"><div><div class="eyebrow">Selected work</div><h2>Selected projects</h2></div><p>Projects with source links, verification evidence, and explicit limitations.</p></div><div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} lang="en" />)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="eyebrow">Capabilities</div><h2>What I work on</h2></div><p>Capability groups backed by public project evidence, not a badge wall.</p></div><div class="capability-grid"><article class="capability"><h3>AI Applications</h3><p>RAG / PDF / Paper / Resume / Agent</p></article><article class="capability"><h3>Agent & Developer Tools</h3><p>Skills / CLI / OCR / Media / Automation</p></article><article class="capability"><h3>Engineering Quality</h3><p>Testing / Validation / CI / Observability / Safety</p></article></div></section>
  <section class="section shell"><div class="section-heading"><div><div class="eyebrow">Current focus</div><h2>What I am building now</h2></div></div><ul class="focus-list"><li><strong>PaperQAAgent</strong>Page-linked evidence and local-first paper research.</li><li><strong>DeepResume</strong>A loop connecting resumes, JDs, learning plans, and career evidence.</li><li><strong>Agent tooling</strong>Installable, verifiable skills and CLI workflows.</li></ul></section>
  <section class="section shell"><div class="section-heading"><div><div class="eyebrow">Notes</div><h2>Engineering notes</h2></div><p>Keeping the reasoning, validation, and boundaries behind the projects.</p></div><div class="actions"><a class="button" href="/en/notes/">Browse notes →</a><a class="button" href="https://github.com/Dithob" target="_blank" rel="noreferrer">GitHub ↗</a></div></section>
</BaseLayout>
