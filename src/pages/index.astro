---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { brand, capabilities, focusItems, projects, signals, site, workflowSteps } from '../data';
const featuredProjects = projects.filter((project) => project.featured);
const latestNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---
<BaseLayout title="wujue / Dithob — AI tools and engineering" description="把生成交给 AI，把判断留给人。" path="/">
  <section class="hero shell">
    <div class="hero-content">
      <div class="hero-kicker"><span>01</span> PERSONAL SYSTEM / 2026</div>
      <h1>{site.name}</h1>
      <p class="lead">{brand.positioning}</p>
      <div class="actions"><a class="button primary" href="/projects/">查看项目 →</a><a class="button" href="/about/">关于我</a><a class="button" href="/notes/">文章索引</a></div>
    </div>
    <aside class="hero-aside">
      <div class="hero-stamp" aria-hidden="true">D/</div>
      <div class="hero-aside-block"><span class="mini-label">NAME</span><p>{site.name}</p></div>
      <div class="hero-aside-block"><span class="mini-label">NOW BUILDING</span><ul class="hero-aside-list"><li>PaperQAAgent</li><li>DeepResume</li><li>reusable agent skills</li></ul></div>
      <div class="hero-aside-block"><span class="mini-label">HOW I WORK</span><p>{brand.tagline}</p></div>
      <div class="hero-aside-code">OPEN SOURCE<br />LOCAL FIRST<br />EVIDENCE LED</div>
    </aside>
    <div class="hero-corner" aria-hidden="true">AI / AGENT / QA</div>
  </section>
  <section class="signal-strip shell" aria-label="个人品牌信号">
    {signals.map((signal) => <div class={`signal signal-${signal.tone}`}><strong>{signal.number}</strong><span>{signal.label}</span><small>{signal.detail}</small></div>)}
  </section>
  <section class="section shell" id="projects">
    <div class="section-heading"><div><div class="section-code">02 / SELECTED WORK</div><h2>精选项目</h2></div><p>四个最能代表当前能力方向的项目。每个项目都保留源码、验证证据和当前限制。</p></div>
    <div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} />)}</div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><div class="section-code">03 / CAPABILITIES</div><h2>我在做什么</h2></div><p>不是技能徽章墙，而是由公开项目支撑的能力分组。</p></div>
    <div class="capability-grid">
      {capabilities.map((capability) => <article class={`capability capability-${capability.tone}`}><span class="capability-number">{capability.number}</span><h3>{capability.title}</h3><p>{capability.detail}</p></article>)}
    </div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><div class="section-code">04 / CURRENT FOCUS</div><h2>现在正在推进</h2></div></div>
    <ul class="focus-list">{focusItems.map((item) => <li><span class="focus-index">{item.number}</span><div><strong>{item.title}</strong>{item.detail}</div></li>)}</ul>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><div class="section-code">05 / WORKFLOW</div><h2>我的工作流</h2></div><p>从事实到系统，再到可核验的交付物。</p></div>
    <div class="workflow-grid">{workflowSteps.map((step) => <article class={`workflow-step workflow-${step.tone}`}><span class="workflow-number">{step.number}</span><h3>{step.title}</h3><p>{step.detail}</p></article>)}</div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><div class="section-code">06 / LATEST NOTES</div><h2>最新笔记</h2></div><p>最近整理的公开笔记：来源、证据与存疑清单一起保留。</p></div>
    <div class="list-grid">
      {latestNotes.map((note) => (
        <article class="note-card">
          <small>{note.data.category} · {note.data.date.toISOString().slice(0, 10)}</small>
          <h3 class="note-card-title"><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
          <p>{note.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section shell">
    <div class="section-heading"><div><div class="section-code">07 / NOTES</div><h2>文章索引</h2></div><p>把项目背后的判断、验证和边界留下来。</p></div>
    <div class="note-banner"><div><span class="mini-label">FIELD NOTES</span><h3>把做过的事情，变成可回看的证据。</h3></div><div class="actions"><a class="button primary" href="/notes/">浏览笔记索引 →</a><a class="button" href="https://github.com/Dithob" target="_blank" rel="noreferrer">访问 GitHub ↗</a></div></div>
  </section>
</BaseLayout>
