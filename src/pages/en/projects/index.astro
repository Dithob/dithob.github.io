---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { projects } from '../../../data';
---
<BaseLayout title="Projects — Dithob" description="Dithob's selected projects and engineering evidence." lang="en" path="/en/projects/"><div class="page-intro shell"><div class="eyebrow">Projects</div><h1>Projects and evidence</h1><p>I show the problem, implementation, verification, and boundaries — not only the stack.</p></div><section class="section shell"><div class="project-grid">{projects.map((project) => <ProjectCard project={project} lang="en" />)}</div></section></BaseLayout>
