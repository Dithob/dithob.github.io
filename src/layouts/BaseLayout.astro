---
import { site, themes } from '../data';

interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  path?: string;
}

const { title, description, lang = 'zh', path = '/' } = Astro.props;
const canonical = new URL(path, Astro.site ?? site.website).toString();
const alternatePath = lang === 'zh' ? `/en${path === '/' ? '/' : path}` : path.replace(/^\/en(?=\/|$)/, '') || '/';
const alternate = new URL(alternatePath, Astro.site ?? site.website).toString();
const themeOptions = themes;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og.svg', Astro.site ?? site.website).toString()} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳转到主要内容' : 'Skip to main content'}</a>
    <header class="site-header">
      <nav class="nav shell" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
        <a class="brand" href={lang === 'zh' ? '/' : '/en/'}>D<span>/</span>wujue</a>
        <div class="nav-links">
          <a href={lang === 'zh' ? '/projects/' : '/en/projects/'}>{lang === 'zh' ? '项目' : 'Projects'}</a>
          <a href={lang === 'zh' ? '/resume/' : '/en/resume/'}>{lang === 'zh' ? '简历' : 'Resume'}</a>
          <a href={lang === 'zh' ? '/notes/' : '/en/notes/'}>{lang === 'zh' ? '笔记' : 'Notes'}</a>
          <a href={lang === 'zh' ? '/about/' : '/en/about/'}>{lang === 'zh' ? '关于' : 'About'}</a>
          <a class="language-toggle" href={alternatePath}>{lang === 'zh' ? 'EN' : '中'}</a>
          <button class="theme-toggle" type="button" aria-label={lang === 'zh' ? '打开风格切换' : 'Open style switcher'} aria-expanded="false" aria-controls="theme-menu" data-theme-toggle>◐</button>
        </div>
      </nav>
      <div class="theme-menu shell" id="theme-menu" data-theme-menu hidden>
        <div class="theme-menu-heading">
          <div>
            <span class="mini-label">{lang === 'zh' ? 'VISUAL SYSTEM' : 'VISUAL SYSTEM'}</span>
            <strong>{lang === 'zh' ? '选择你的主页气质' : 'Choose a visual direction'}</strong>
          </div>
          <span class="theme-current" data-theme-current></span>
        </div>
        <div class="theme-options" role="list">
          {themeOptions.map((theme) => (
            <button
              class={`theme-option theme-option-${theme.id}`}
              type="button"
              data-theme-option={theme.id}
              role="listitem"
              aria-pressed="false"
            >
              <span class="theme-option-mark">{lang === 'zh' ? theme.short : theme.shortEn}</span>
              <span>
                <strong>{lang === 'zh' ? theme.label : theme.labelEn}</strong>
                <small>{lang === 'zh' ? theme.labelEn : theme.label}</small>
              </span>
            </button>
          ))}
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div><strong>Dithob</strong><span> · </span>{lang === 'zh' ? '构建可运行、可解释、可核验的 AI 工具。' : 'Building runnable, explainable, and verifiable AI tools.'}</div>
      <div class="footer-links">
        <a href={site.github} rel="me">GitHub</a>
        <a href="https://github.com/Dithob" target="_blank" rel="noreferrer">Contact</a>
        <span>© 2026</span>
      </div>
    </footer>
    <script is:inline>
      const key = 'dithob-visual-theme';
      const root = document.documentElement;
      const defaultTheme = 'neo-brutalist';
      const validThemes = ['neo-brutalist', 'editorial', 'minimalist-flat', 'bento-grid', 'geometric-bold'];
      const saved = localStorage.getItem(key);
      const setTheme = (theme) => {
        const next = validThemes.includes(theme) ? theme : defaultTheme;
        root.dataset.theme = next;
        localStorage.setItem(key, next);
        document.querySelectorAll('[data-theme-option]').forEach((option) => {
          option.setAttribute('aria-pressed', option.dataset.themeOption === next ? 'true' : 'false');
        });
        const current = document.querySelector('[data-theme-current]');
        const selected = document.querySelector(`[data-theme-option="${next}"] strong`);
        if (current) current.textContent = selected?.textContent?.trim() || next.replaceAll('-', ' ').toUpperCase();
      };
      setTheme(saved || defaultTheme);
      const menu = document.querySelector('[data-theme-menu]');
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const open = menu?.hasAttribute('hidden');
        if (open) {
          menu?.removeAttribute('hidden');
        } else {
          menu?.setAttribute('hidden', '');
        }
        toggle?.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('[data-theme-option]').forEach((option) => {
        option.addEventListener('click', () => {
          setTheme(option.dataset.themeOption || defaultTheme);
          menu?.setAttribute('hidden', '');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu?.setAttribute('hidden', '');
          toggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --bg: #fffdf7; --surface: #ffffff; --surface-soft: #f4f0e6; --text: #080808; --muted: #313131; --subtle: #646464; --line: #080808; --accent: #ff006e; --accent-soft: #ff006e; --warm: #ff9500; --pink: #ff006e; --lime: #ccff00; --blue: #00d9ff; --orange: #ff9500; --purple: #a78bfa; --red: #ff4d4d; --shadow: 8px 8px 0 #080808; --shadow-small: 4px 4px 0 #080808; --heading-font: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; --body-font: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
  :root[data-theme='editorial'] { --bg: #f5f0e8; --surface: #fbf8f2; --surface-soft: #e4ddd0; --text: #17130f; --muted: #625a50; --subtle: #8d8173; --line: #17130f; --accent: #a43b28; --accent-soft: #a43b28; --warm: #c8a05a; --pink: #a43b28; --lime: #d6c29a; --blue: #38536c; --orange: #c47b3c; --purple: #6d586f; --red: #a43b28; --shadow: 8px 8px 0 #17130f; --shadow-small: 3px 3px 0 #17130f; --heading-font: Georgia, "Times New Roman", serif; --body-font: Arial, Helvetica, sans-serif; }
  :root[data-theme='minimalist-flat'] { --bg: #ffffff; --surface: #ffffff; --surface-soft: #f2f2f2; --text: #050505; --muted: #3c3c3c; --subtle: #777777; --line: #050505; --accent: #ff3366; --accent-soft: #ff3366; --warm: #ffcc00; --pink: #ff3366; --lime: #ffcc00; --blue: #00d4aa; --orange: #ffcc00; --purple: #6557d2; --red: #ff3366; --shadow: none; --shadow-small: none; --heading-font: Arial, Helvetica, sans-serif; --body-font: Arial, Helvetica, sans-serif; }
  :root[data-theme='bento-grid'] { color-scheme: light; --bg: #ffffff; --surface: #ffffff; --surface-soft: #f7f8fa; --text: #151515; --muted: #5f6368; --subtle: #9298a1; --line: #e5e7eb; --accent: #2563eb; --accent-soft: #2563eb; --warm: #f59e0b; --pink: #2563eb; --lime: #e9eef7; --blue: #2563eb; --orange: #f59e0b; --purple: #7c3aed; --red: #dc2626; --shadow: 0 14px 30px rgba(17, 24, 39, .06); --shadow-small: 0 5px 14px rgba(17, 24, 39, .05); --heading-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; --body-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :root[data-theme='geometric-bold'] { color-scheme: dark; --bg: #090909; --surface: #111111; --surface-soft: #1a1a1a; --text: #f5f5f5; --muted: #b8b8b8; --subtle: #7c7c7c; --line: #eeeeee; --accent: #c8ff00; --accent-soft: #c8ff00; --warm: #ffb000; --pink: #c8ff00; --lime: #c8ff00; --blue: #8ee7ff; --orange: #ffb000; --purple: #b7a5ff; --red: #ff6b8a; --shadow: none; --shadow-small: none; --heading-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; --body-font: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :root[data-theme='neo-brutalist'] { color-scheme: light; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--body-font); line-height: 1.55; }
  a { color: inherit; text-decoration-color: var(--line); text-underline-offset: .2em; }
  a:hover { color: var(--pink); text-decoration-color: currentColor; }
  .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -4rem; padding: .6rem 1rem; background: var(--text); color: var(--bg); z-index: 10; border: 3px solid var(--line); box-shadow: var(--shadow-small); }
  .skip-link:focus { top: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 3px solid var(--line); }
  .nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { font-family: var(--heading-font); font-weight: 950; letter-spacing: -.08em; text-decoration: none; font-size: 1.05rem; }
  .brand span { color: var(--pink); }
  .nav-links { display: flex; align-items: center; gap: 0; color: var(--text); font-size: .82rem; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; }
  .nav-links a { text-decoration: none; }
  .nav-links > a { padding: .7rem .8rem; border-left: 3px solid var(--line); }
  .nav-links > a:hover { background: var(--lime); color: var(--text); }
  .language-toggle { background: var(--pink); color: var(--text); }
  .theme-toggle { border: 3px solid var(--line); color: var(--text); background: var(--surface); width: 2.4rem; height: 2.4rem; cursor: pointer; margin-left: .8rem; box-shadow: var(--shadow-small); font-weight: 950; }
  .theme-toggle:active, .button:active { transform: translate(4px, 4px); box-shadow: none; }
  .theme-menu { position: absolute; top: calc(100% + 1rem); left: 50%; transform: translateX(-50%); z-index: 8; padding: 1rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  .theme-menu[hidden] { display: none; }
  .theme-menu-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1rem; }
  .theme-menu-heading strong { display: block; margin-top: .35rem; font-family: var(--heading-font); font-size: 1.3rem; }
  .theme-current { color: var(--accent); font-size: .72rem; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  .theme-options { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .7rem; }
  .theme-option { display: grid; gap: .7rem; min-height: 112px; padding: .8rem; border: 3px solid var(--line); color: var(--text); background: var(--bg); text-align: left; cursor: pointer; box-shadow: var(--shadow-small); font-family: var(--body-font); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .theme-option:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--accent); }
  .theme-option[aria-pressed='true'] { outline: 4px solid var(--accent); outline-offset: 2px; }
  .theme-option strong, .theme-option small { display: block; }
  .theme-option strong { font-family: var(--heading-font); font-size: .87rem; }
  .theme-option small { margin-top: .2rem; color: var(--subtle); font-size: .66rem; font-weight: 800; }
  .theme-option-mark { display: block; width: fit-content; min-width: 3.3rem; padding: .35rem .45rem; border: 2px solid var(--line); font-size: .72rem; font-weight: 950; letter-spacing: .08em; background: var(--text); color: var(--bg); }
  .theme-option-editorial { background: #f5f0e8; }
  .theme-option-editorial .theme-option-mark { background: #a43b28; color: #f5f0e8; }
  .theme-option-minimalist-flat { background: #ffffff; }
  .theme-option-minimalist-flat .theme-option-mark { background: #ff3366; }
  .theme-option-bento-grid { background: #ffffff; }
  .theme-option-bento-grid .theme-option-mark { background: #2563eb; color: #ffffff; }
  .theme-option-geometric-bold { background: #090909; color: #f5f5f5; }
  .theme-option-geometric-bold .theme-option-mark { background: #c8ff00; color: #090909; border-color: #f5f5f5; }
  .hero { position: relative; padding: 6.8rem 0 4.8rem; display: grid; grid-template-columns: minmax(0, 1.32fr) minmax(280px, .68fr); gap: 3rem; align-items: end; border-bottom: 3px solid var(--line); }
  .hero::before { content: ''; position: absolute; inset: 2rem 0 auto; height: 1.2rem; border-block: 3px dashed var(--line); opacity: .9; }
  .hero-content { position: relative; z-index: 1; }
  .hero-kicker, .section-code, .mini-label { color: var(--text); font-size: .78rem; font-weight: 950; letter-spacing: .1em; text-transform: uppercase; }
  .hero-kicker { display: inline-flex; gap: .75rem; align-items: center; padding: .55rem .8rem; background: var(--lime); border: 3px solid var(--line); box-shadow: var(--shadow-small); }
  .hero-kicker span { color: var(--pink); }
  .eyebrow { color: var(--pink); font-size: .82rem; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3 { font-family: var(--heading-font); line-height: 1.02; letter-spacing: -.08em; font-weight: 950; }
  h1 { font-size: clamp(3.4rem, 8vw, 7.4rem); margin: 1.3rem 0 1.5rem; max-width: 9ch; }
  h2 { font-size: clamp(2.4rem, 5vw, 4.3rem); margin: .5rem 0 1rem; }
  h3 { font-size: 1.3rem; margin: 0 0 .6rem; }
  .lead { max-width: 720px; font-size: clamp(1rem, 1.7vw, 1.25rem); color: var(--muted); font-weight: 700; }
  .hero-aside { position: relative; border: 3px solid var(--line); padding: 1.4rem; color: var(--text); background: var(--blue); box-shadow: var(--shadow); }
  .hero-stamp { position: absolute; right: .8rem; top: -.85rem; background: var(--pink); border: 3px solid var(--line); padding: .3rem .55rem; font-size: 1.6rem; font-weight: 950; transform: rotate(3deg); box-shadow: var(--shadow-small); }
  .hero-aside-block { border-bottom: 3px solid var(--line); padding: .4rem 0 1rem; margin-bottom: 1rem; }
  .hero-aside-block p { margin: .45rem 0 0; font-weight: 850; }
  .hero-aside-code { font-size: .75rem; font-weight: 950; line-height: 1.7; }
  .hero-corner { position: absolute; right: 0; bottom: .8rem; color: var(--pink); font-size: .7rem; font-weight: 950; letter-spacing: .12em; transform: rotate(-90deg) translateX(100%); transform-origin: right bottom; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .button { display: inline-flex; align-items: center; gap: .5rem; padding: .78rem 1rem; border: 3px solid var(--line); text-decoration: none; font-weight: 950; background: var(--surface); box-shadow: var(--shadow-small); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .button:hover { background: var(--lime); color: var(--text); transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pink); }
  .button.primary { background: var(--text); color: var(--bg); border-color: var(--line); }
  .button.primary:hover { background: var(--pink); color: var(--text); }
  .section { padding: 5.5rem 0; border-top: 3px solid var(--line); }
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .section-code { color: var(--pink); }
  .section-heading p { max-width: 480px; margin: 0; color: var(--muted); }
  .signal-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-inline: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .signal { display: grid; grid-template-columns: auto 1fr; gap: .3rem .8rem; padding: 1rem; border-right: 3px solid var(--line); color: var(--text); }
  .signal:last-child { border-right: 0; }
  .signal strong { font-size: 1.6rem; line-height: 1; }
  .signal span { font-weight: 950; align-self: end; }
  .signal small { grid-column: 2; font-size: .65rem; font-weight: 950; letter-spacing: .1em; }
  .signal-pink { background: var(--pink); }
  .signal-lime { background: var(--lime); }
  .signal-blue { background: var(--blue); }
  .signal-orange { background: var(--orange); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem; }
  .project-card { position: relative; display: flex; flex-direction: column; gap: 1rem; min-height: 310px; padding: 1.35rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow); transition: transform 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out; }
  .project-card:hover { transform: translate(-4px, -4px); box-shadow: 12px 12px 0 var(--pink); background: var(--lime); }
  .project-meta { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .7rem; color: var(--subtle); font-size: .73rem; font-weight: 950; text-transform: uppercase; }
  .project-code { color: var(--pink); }
  .project-accent { display: block; height: 8px; background: var(--pink); }
  .accent-pink { background: var(--pink); }
  .accent-lime { background: var(--lime); }
  .accent-blue { background: var(--blue); }
  .accent-orange { background: var(--orange); }
  .accent-purple { background: var(--purple); }
  .accent-red { background: var(--red); }
  .project-status { text-align: right; white-space: nowrap; }
  .project-card h3 { font-size: 1.6rem; margin-bottom: .35rem; }
  .project-card h3 a { text-decoration: none; }
  .project-category { display: inline-block; color: var(--text); font-size: .72rem; font-weight: 950; margin-bottom: .75rem; border-bottom: 3px solid var(--pink); }
  .project-card p { color: var(--muted); margin: 0; font-weight: 700; }
  .stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: auto; }
  .tag { padding: .25rem .5rem; border: 2px solid var(--line); background: var(--bg); color: var(--text); font-size: .72rem; font-weight: 850; }
  .card-links { display: flex; gap: 1rem; font-size: .82rem; font-weight: 950; text-transform: uppercase; }
  .project-proof { display: flex; gap: .55rem; font-size: .66rem; font-weight: 950; letter-spacing: .06em; text-transform: uppercase; }
  .project-proof span { padding: .25rem .4rem; border: 2px solid var(--line); background: var(--pink); color: var(--text); }
  .project-proof span:last-child { background: var(--blue); }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .capability { position: relative; min-height: 180px; padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); }
  .capability-pink { background: var(--pink); }
  .capability-lime { background: var(--lime); }
  .capability-blue { background: var(--blue); }
  .capability-number { position: absolute; right: 1rem; top: .7rem; font-size: 1.9rem; font-weight: 950; opacity: .5; }
  .capability p { color: var(--text); margin-bottom: 0; font-weight: 850; }
  .focus-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; list-style: none; }
  .focus-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 3px solid var(--line); color: var(--muted); font-weight: 700; }
  .focus-list strong { color: var(--text); display: block; margin-bottom: .35rem; font-weight: 950; }
  .focus-index { color: var(--pink); font-size: 1.6rem; font-weight: 950; }
  .workflow-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
  .workflow-step { position: relative; min-height: 190px; padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); }
  .workflow-pink { background: var(--pink); }
  .workflow-lime { background: var(--lime); }
  .workflow-blue { background: var(--blue); }
  .workflow-number { display: block; color: var(--text); font-size: 1.7rem; font-weight: 950; }
  .workflow-step h3 { margin-top: 2.2rem; }
  .workflow-step p { color: var(--text); margin-bottom: 0; font-weight: 750; }
  .note-banner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 1.4rem; border: 3px solid var(--line); background: var(--orange); box-shadow: var(--shadow); }
  .note-banner h3 { margin: .5rem 0 0; max-width: 20ch; }
  .page-intro { padding: 6rem 0 3.5rem; max-width: 780px; }
  .page-intro h1 { max-width: 100%; overflow-wrap: anywhere; word-break: break-word; }
  .page-intro p { font-size: 1.2rem; color: var(--muted); }
  .content-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 3rem; }
  .prose h2 { margin-top: 2.4rem; }
  .prose p, .prose li { color: var(--muted); }
  .facts { padding: 1.3rem; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--shadow-small); height: fit-content; }
  .facts dt { color: var(--subtle); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; margin-top: 1rem; }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: .25rem 0 0; }
  .list-grid { display: grid; gap: 1rem; }
  .note-card { padding: 1.25rem; border: 3px solid var(--line); box-shadow: var(--shadow-small); background: var(--surface); }
  .note-card:nth-child(1) { background: var(--pink); }
  .note-card:nth-child(2) { background: var(--blue); }
  .note-card:nth-child(3) { background: var(--lime); }
  .note-card small { color: var(--text); font-weight: 950; }
