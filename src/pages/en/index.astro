---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { brand, capabilities, focusItems, projects, signals, site, workflowSteps } from '../../data';
const featuredProjects = projects.filter((project) => project.featured);
const latestNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---
<BaseLayout title="wujue / Dithob — AI tools and engineering" description="AI generates. Humans judge." lang="en" path="/en/">
  <section class="hero shell"><div class="hero-content"><div class="hero-kicker"><span>01</span> PERSONAL SYSTEM / 2026</div><h1>{site.name}</h1><p class="lead">{brand.positioningEn}</p><div class="actions"><a class="button primary" href="/en/projects/">View projects →</a><a class="button" href="/en/about/">About</a><a class="button" href="/en/notes/">Notes</a></div></div><aside class="hero-aside"><div class="hero-stamp" aria-hidden="true">D/</div><div class="hero-aside-block"><span class="mini-label">NAME</span><p>{site.name}</p></div><div class="hero-aside-block"><span class="mini-label">NOW BUILDING</span><p>PaperQAAgent · DeepResume · reusable agent skills</p></div><div class="hero-aside-block"><span class="mini-label">HOW I WORK</span><p>{brand.taglineEn}</p></div><div class="hero-aside-code">OPEN SOURCE<br />LOCAL FIRST<br />EVIDENCE LED</div></aside><div class="hero-corner" aria-hidden="true">AI / AGENT / QA</div></section>
  <section class="signal-strip shell" aria-label="Personal brand signals">{signals.map((signal) => <div class={`signal signal-${signal.tone}`}><strong>{signal.number}</strong><span>{signal.labelEn}</span><small>{signal.detailEn}</small></div>)}</section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">02 / SELECTED WORK</div><h2>Selected projects</h2></div><p>Projects with source links, verification evidence, and explicit limitations.</p></div><div class="project-grid">{featuredProjects.map((project) => <ProjectCard project={project} lang="en" />)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">03 / CAPABILITIES</div><h2>What I work on</h2></div><p>Capability groups backed by public project evidence, not a badge wall.</p></div><div class="capability-grid">{capabilities.map((capability) => <article class={`capability capability-${capability.tone}`}><span class="capability-number">{capability.number}</span><h3>{capability.titleEn}</h3><p>{capability.detailEn}</p></article>)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">04 / CURRENT FOCUS</div><h2>What I am building now</h2></div></div><ul class="focus-list">{focusItems.map((item) => <li><span class="focus-index">{item.number}</span><div><strong>{item.titleEn}</strong>{item.detailEn}</div></li>)}</ul></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">05 / WORKFLOW</div><h2>My workflow</h2></div><p>From facts to systems, then to evidence you can inspect.</p></div><div class="workflow-grid">{workflowSteps.map((step) => <article class={`workflow-step workflow-${step.tone}`}><span class="workflow-number">{step.number}</span><h3>{step.titleEn}</h3><p>{step.detailEn}</p></article>)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">06 / LATEST NOTES</div><h2>Latest notes</h2></div><p>Recently published notes with sources, evidence, and open questions.</p></div><div class="list-grid">{latestNotes.map((note) => <article class="note-card"><small>{note.data.categoryEn} · {note.data.date.toISOString().slice(0, 10)}</small><h3 class="note-card-title"><a href={`/notes/${note.id}/`}>{note.data.titleEn}</a></h3><p>{note.data.summaryEn}</p></article>)}</div></section>
  <section class="section shell"><div class="section-heading"><div><div class="section-code">07 / NOTES</div><h2>Article index</h2></div><p>Keeping the reasoning, validation, and boundaries behind the projects.</p></div><div class="note-banner"><div><span class="mini-label">FIELD NOTES</span><h3>Turn the work into evidence you can revisit.</h3></div><div class="actions"><a class="button primary" href="/en/notes/">Browse notes →</a><a class="button" href="https://github.com/Dithob" target="_blank" rel="noreferrer">GitHub ↗</a></div></div></section>
</BaseLayout>
