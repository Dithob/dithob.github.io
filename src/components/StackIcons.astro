---
import { stackIconSlugs } from '../data';

interface Props {
  stack: string[];
  size?: number;
}

const { stack, size = 40 } = Astro.props;

/** Short mark for labels without a skillicons badge: OCR -> OCR, HTTP API -> HTTP, Agent Skill -> AS. */
const FALLBACK_MARKS: Record<string, string> = {
  'PyMuPDF': 'PDF',
  'OpenAI-compatible API': 'AI',
  'HTTP API': 'HTTP',
  'JSON Schema': 'JSON',
  'Unix Socket': 'SOCK',
  'Agent Skill': 'SKILL',
};

const markFor = (label: string): string => {
  if (FALLBACK_MARKS[label]) return FALLBACK_MARKS[label];
  const words = label.split(/[\s\-/]+/).filter(Boolean);
  if (words.length === 1) return words[0].slice(0, 3).toUpperCase();
  return words.map((word) => word[0]).join('').slice(0, 4).toUpperCase();
};

const items = stack.map((label) => ({
  label,
  slug: stackIconSlugs[label] ?? null,
  mark: markFor(label),
}));
---
<div class="stack-icon-row" role="list">
  {items.map(({ label, slug, mark }) => (
    <span class="stack-item" role="listitem" title={label}>
      {slug ? (
        <img
          class="stack-icon"
          src={`https://skillicons.dev/icons?i=${slug}&theme=light`}
          alt={label}
          width={size}
          height={size}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="stack-icon stack-icon-fallback" style={`font-size:${Math.round(size * 0.24)}px;width:${size}px;height:${size}px`} aria-hidden="true">{mark}</span>
      )}
      <span class="stack-item-label">{label}</span>
    </span>
  ))}
</div>

<style>
  .stack-icon-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.9rem;
  }
  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .stack-icon {
    display: inline-block;
    border-radius: 0.5rem;
    flex: 0 0 auto;
  }
  .stack-icon-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-soft);
    border: 2px solid var(--line);
    color: var(--text);
    font-family: var(--heading-font);
    font-weight: 950;
    letter-spacing: 0.02em;
  }
  .stack-item-label {
    font-size: 0.76rem;
    font-weight: 850;
    color: var(--muted);
    white-space: nowrap;
  }
  /* Dark theme (Black Mode): invert the light-theme badges so they stay legible. */
  :global([data-theme='geometric-bold']) img.stack-icon {
    filter: invert(0.92) hue-rotate(180deg);
  }
</style>
